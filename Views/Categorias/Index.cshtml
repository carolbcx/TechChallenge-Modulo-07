@model IEnumerable<TechChallenge.Categoria>

@{
    ViewData["Title"] = "Categorias";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4">
    <div>
        <h1 class="mb-1">Categorias</h1>
        <p class="text-muted mt-0">Gerencie as categorias que serão usadas em projetos e filtros do sistema.</p>
    </div>
    <a class="btn btn-primary btn-sm" asp-action="Create">Nova Categoria</a>
</div>

<div class="table-responsive shadow-sm rounded-3 bg-white p-3">
    <table class="table table-hover table-striped align-middle mb-0">
        <thead>
            <tr>
                <th>@Html.DisplayNameFor(model => model.Nome)</th>
                <th>@Html.DisplayNameFor(model => model.Descricao)</th>
                <th>@Html.DisplayNameFor(model => model.Cor)</th>
                <th>@Html.DisplayNameFor(model => model.Ativa)</th>
                <th>@Html.DisplayNameFor(model => model.DataCadastro)</th>
                <th class="text-end">Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@Html.DisplayFor(modelItem => item.Nome)</td>
                    <td>@Html.DisplayFor(modelItem => item.Descricao)</td>
                    <td><span class="text-nowrap" style="color:@item.Cor">@item.Cor</span></td>
                    <td>
                        @if (item.Ativa)
                        {
                            <span class="badge bg-success">Ativo</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Inativo</span>
                        }
                    </td>
                    <td>@Html.DisplayFor(modelItem => item.DataCadastro)</td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-primary me-1" asp-action="Edit" asp-route-id="@item.Id">Editar</a>
                        <a class="btn btn-sm btn-outline-secondary me-1" asp-action="Details" asp-route-id="@item.Id">Detalhes</a>
                        <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@item.Id">Excluir</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
