@{
    ViewData["Title"] = "Criar Novo Perfil";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-6 offset-md-3">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">@ViewData["Title"]</h5>
                </div>
                <div class="card-body">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <form method="post">
                        <div class="mb-3">
                            <label for="nome" class="form-label">Nome do Perfil *</label>
                            <input type="text" class="form-control" id="nome" name="nome" required placeholder="Ex: Admin, Professor, Aluno, Coordenador" maxlength="100">
                            <small class="form-text text-muted">Sem espaços em branco - use nomes claros e descritivos</small>
                        </div>

                        <div class="alert alert-info" role="alert">
                            <small>💡 <strong>Dica:</strong> Use nomes descritivos sem espaços (Ex: Admin, Professor, Aluno, Coordenador).</small>
                        </div>

                        <div class="alert alert-primary" role="alert">
                            <small><strong>ℹ️ Informação:</strong> Após criar o perfil, você poderá associá-lo aos usuários do sistema.</small>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-plus-circle"></i> Criar Perfil
                            </button>
                            <a asp-action="Roles" class="btn btn-secondary">
                                <i class="bi bi-arrow-left"></i> Voltar
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
