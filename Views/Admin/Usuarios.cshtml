@model IEnumerable<Microsoft.AspNetCore.Identity.IdentityUser>
@{
    ViewData["Title"] = "Gerenciar Usuários";
    var rolesUsuario = ViewBag.RolesUsuarios as Dictionary<string, string>;
}

<div class="container mt-4">
    <div class="row mb-4">
        <div class="col-md-6">
            <h2>@ViewData["Title"]</h2>
        </div>
        <div class="col-md-6 text-end">
            <a asp-action="CriarUsuario" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Novo Usuário
            </a>
        </div>
    </div>

    @if (TempData["Sucesso"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show d-flex align-items-center" role="alert">
            <i class="bi bi-check-circle me-2"></i>
            <div>@TempData["Sucesso"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Erro"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>
            <div>@TempData["Erro"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="table-responsive">
        <table class="table table-hover">
            <thead class="table-dark">
                <tr>
                    <th>E-mail</th>
                    <th>Cargo</th>
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    foreach (var usuario in Model)
                    {
                        <tr>
                            <td>
                                @usuario.Email
                            </td>
                            <td>
                                @if (rolesUsuario != null && rolesUsuario.ContainsKey(usuario.Id))
                                {
                                    var role = rolesUsuario[usuario.Id];
                                    @if (role == "Admin")
                                    {
                                        <span class="badge bg-danger">@role</span>
                                    }
                                    else if (role == "Professor")
                                    {
                                        <span class="badge bg-info">@role</span>
                                    }
                                    else if (role == "Aluno")
                                    {
                                        <span class="badge bg-success">@role</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">@role</span>
                                    }
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Sem Perfil</span>
                                }
                            </td>
                            <td>
                                <div class="btn-group btn-group-sm" role="group">
                                    <a asp-action="EditarUsuario" asp-route-id="@usuario.Id" class="btn btn-outline-primary" title="Editar">
                                        <i class="bi bi-pencil"></i> Editar
                                    </a>
                                    <a asp-action="TrocarPerfil" asp-route-id="@usuario.Id" class="btn btn-outline-warning" title="Trocar Perfil">
                                        <i class="bi bi-shield-check"></i> Perfil
                                    </a>
                                    <a asp-action="ExcluirUsuario" asp-route-id="@usuario.Id" class="btn btn-outline-danger" onclick="return confirm('Tem certeza que deseja excluir este usuário?');" title="Excluir">
                                        <i class="bi bi-trash"></i> Excluir
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="3" class="text-center py-4">
                            <p class="text-muted">Nenhum usuário encontrado.</p>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
                        </td>
                    </tr>
            </tbody>
        </table>
    </div>


</div>