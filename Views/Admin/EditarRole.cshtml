@model Microsoft.AspNetCore.Identity.IdentityRole
@{
    ViewData["Title"] = "Editar Perfil";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-6 offset-md-3">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">@ViewData["Title"]</h5>
                </div>
                <div class="card-body">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <form method="post">
                        <div class="mb-3">
                            <label for="id" class="form-label">ID</label>
                            <input type="text" class="form-control" id="id" value="@Model.Id" disabled>
                            <input type="hidden" name="id" value="@Model.Id">
                        </div>

                        <div class="mb-3">
                            <label for="nome" class="form-label">Nome do Perfil *</label>
                            <input type="text" class="form-control" id="nome" name="nome" required value="@Model.Name" placeholder="Digite o novo nome do perfil" maxlength="100">
                            <small class="form-text text-muted">Sem espaços em branco - use nomes claros e descritivos</small>
                        </div>

                        <div class="alert alert-warning" role="alert">
                            <small><strong>⚠️ Atenção:</strong> Alterar o nome do perfil pode afetar as permissões dos usuários associados a este perfil.</small>
                        </div>

                        <div class="alert alert-info" role="alert">
                            <small><strong>ℹ️ Informação:</strong> Certifique-se de que todos os usuários com este perfil foram notificados sobre a alteração.</small>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check-circle"></i> Salvar Alterações
                            </button>
                            <a asp-action="Roles" class="btn btn-secondary">
                                <i class="bi bi-arrow-left"></i> Voltar
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
