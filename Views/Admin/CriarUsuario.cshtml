@{
    ViewData["Title"] = "Criar Novo Usuário";
    var roles = ViewBag.Roles as List<Microsoft.AspNetCore.Identity.IdentityRole>;
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-6 offset-md-3">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">@ViewData["Title"]</h5>
                </div>
                <div class="card-body">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger d-none" role="alert"></div>

                    <form method="post" novalidate>
                        <div class="mb-3">
                            <label for="email" class="form-label">E-mail *</label>
                            <input type="email" class="form-control" id="email" name="email" required placeholder="Digite o e-mail do usuário">
                            <small class="form-text text-muted">Um endereço de e-mail válido é obrigatório</small>
                        </div>

                        <div class="mb-3">
                            <label for="senha" class="form-label">Senha *</label>
                            <input type="password" class="form-control" id="senha" name="senha" required placeholder="Digite a senha do usuário">
                            <small class="form-text text-muted">Mínimo 4 caracteres</small>
                        </div>

                        <div class="mb-3">
                            <label for="role" class="form-label">Perfil (Opcional)</label>
                            <select class="form-select" id="role" name="role">
                                <option value="">-- Sem Perfil --</option>
                                @if (roles != null && roles.Any())
                                {
                                    foreach (var role in roles)
                                    {
                                        <option value="@role.Name">@role.Name</option>
                                    }
                                }
                            </select>
                            <small class="form-text text-muted">Você poderá alterar o perfil do usuário depois</small>
                        </div>

                        <div class="alert alert-info" role="alert">
                            <small><strong>ℹ️ Informação:</strong> O novo usuário será criado com o perfil selecionado. Você poderá alterá-lo posteriormente.</small>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-plus-circle"></i> Criar
                            </button>
                            <a asp-action="Usuarios" class="btn btn-secondary">
                                <i class="bi bi-arrow-left"></i> Voltar
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
