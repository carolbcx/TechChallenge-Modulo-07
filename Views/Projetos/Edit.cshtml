@model TechChallenge.Models.Projeto

@{
    ViewData["Title"] = "Editar Projeto";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="page-card">
            <h1 class="page-title">Editar Projeto</h1>
            <p class="text-muted mb-4">Atualize as informações do projeto e altere os vínculos conforme necessário.</p>

            <form asp-action="Edit">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <input type="hidden" asp-for="Id" />
                <div class="mb-3">
                    <label asp-for="Nome" class="form-label"></label>
                    <input asp-for="Nome" class="form-control" />
                    <span asp-validation-for="Nome" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Descricao" class="form-label"></label>
                    <input asp-for="Descricao" class="form-control" />
                    <span asp-validation-for="Descricao" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="DataInicio" class="form-label"></label>
                    <input asp-for="DataInicio" class="form-control" />
                    <span asp-validation-for="DataInicio" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="DataFim" class="form-label"></label>
                    <input asp-for="DataFim" class="form-control" />
                    <span asp-validation-for="DataFim" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Pontuacao" class="form-label"></label>
                    <input asp-for="Pontuacao" class="form-control" />
                    <span asp-validation-for="Pontuacao" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="ProfessorId" class="form-label"></label>
                    <select asp-for="ProfessorId" class="form-control" asp-items="ViewBag.ProfessorId"></select>
                    <span asp-validation-for="ProfessorId" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="CategoriaId" class="form-label"></label>
                    <select asp-for="CategoriaId" class="form-control" asp-items="ViewBag.CategoriaId"></select>
                    <span asp-validation-for="CategoriaId" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="EquipeId" class="form-label"></label>
                    <select asp-for="EquipeId" class="form-control" asp-items="ViewBag.EquipeId"></select>
                    <span asp-validation-for="EquipeId" class="text-danger"></span>
                </div>
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Salvar</button>
                    <a class="btn btn-outline-secondary" asp-action="Index">Voltar</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
