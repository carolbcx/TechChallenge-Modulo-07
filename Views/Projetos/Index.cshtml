@model IEnumerable<TechChallenge.Models.Projeto>

@{
    ViewData["Title"] = "Projetos";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4">
    <div>
        <h1 class="mb-1">Projetos</h1>
        <p class="text-muted mb-0">Gerencie os projetos cadastrados no sistema e vincule categorias, professores e equipes.</p>
    </div>
    <a class="btn btn-primary btn-sm" asp-action="Create">Novo Projeto</a>
</div>

<div class="table-responsive shadow-sm rounded-3 bg-white p-3">
    <table class="table table-hover table-striped align-middle mb-0">
        <thead>
            <tr>
                <th>@Html.DisplayNameFor(model => model.Nome)</th>
                <th>@Html.DisplayNameFor(model => model.Descricao)</th>
                <th>@Html.DisplayNameFor(model => model.DataInicio)</th>
                <th>@Html.DisplayNameFor(model => model.DataFim)</th>
                <th>@Html.DisplayNameFor(model => model.Pontuacao)</th>
                <th>@Html.DisplayNameFor(model => model.Professor)</th>
                <th>@Html.DisplayNameFor(model => model.Categoria)</th>
                <th>@Html.DisplayNameFor(model => model.Equipe)</th>
                <th class="text-end">Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@Html.DisplayFor(modelItem => item.Nome)</td>
                    <td>@Html.DisplayFor(modelItem => item.Descricao)</td>
                    <td>@Html.DisplayFor(modelItem => item.DataInicio)</td>
                    <td>@Html.DisplayFor(modelItem => item.DataFim)</td>
                    <td>@Html.DisplayFor(modelItem => item.Pontuacao)</td>
                    <td>@Html.DisplayFor(modelItem => item.Professor.Email)</td>
                    <td>@Html.DisplayFor(modelItem => item.Categoria.Nome)</td>
                    <td>@Html.DisplayFor(modelItem => item.Equipe.Nome)</td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-primary me-1" asp-action="Edit" asp-route-id="@item.Id">Editar</a>
                        <a class="btn btn-sm btn-outline-secondary me-1" asp-action="Details" asp-route-id="@item.Id">Detalhes</a>
                        <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@item.Id">Excluir</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
