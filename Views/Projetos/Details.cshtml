@model TechChallenge.Models.Projeto

@{
    ViewData["Title"] = "Detalhes do Projeto";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="page-card">
            <div class="d-flex justify-content-between align-items-start mb-4">
                <div>
                    <h1 class="page-title">Detalhes do Projeto</h1>
                    <p class="text-muted mb-0">Visualize as informações completas do projeto selecionado.</p>
                </div>
                <a class="btn btn-outline-secondary btn-sm" asp-action="Index">Voltar</a>
            </div>

            <dl class="row gx-4 gy-3">
                <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Nome)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.Nome)</dd>
                <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Descricao)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.Descricao)</dd>
                <dt class="col-sm-3">@Html.DisplayNameFor(model => model.DataInicio)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.DataInicio)</dd>
                <dt class="col-sm-3">@Html.DisplayNameFor(model => model.DataFim)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.DataFim)</dd>
                <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Pontuacao)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.Pontuacao)</dd>
                <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Professor)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.Professor.Email)</dd>
                <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Categoria)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.Categoria.Nome)</dd>
                <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Equipe)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.Equipe.Nome)</dd>
            </dl>

            <div class="mt-4 d-flex gap-2">
                <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Editar</a>
                <a class="btn btn-outline-secondary" asp-action="Index">Voltar</a>
            </div>
        </div>
    </div>
</div>
