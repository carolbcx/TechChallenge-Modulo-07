@model TechChallenge.Professor

@{
    ViewData["Title"] = "Detalhes do Professor";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="page-card">
            <div class="d-flex justify-content-between align-items-start mb-4">
                <div>
                    <h1 class="page-title">Detalhes do Professor</h1>
                    <p class="text-muted mb-0">Confira as informações detalhadas deste professor.</p>
                </div>
                <a class="btn btn-outline-secondary btn-sm" asp-action="Index">Voltar</a>
            </div>

            <dl class="row gx-4 gy-3">
                <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Nome)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.Nome)</dd>
                <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Email)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.Email)</dd>
                <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Especialidade)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.Especialidade)</dd>
                <dt class="col-sm-3">@Html.DisplayNameFor(model => model.DataContratacao)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.DataContratacao)</dd>
                <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Ativo)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.Ativo)</dd>
            </dl>

            <div class="mt-4 d-flex gap-2">
                <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Editar</a>
                <a class="btn btn-outline-secondary" asp-action="Index">Voltar</a>
            </div>
        </div>
    </div>
</div>
